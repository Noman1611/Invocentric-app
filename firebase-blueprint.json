{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "display_name": { "type": "string" },
        "photo_url": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "is_admin": { "type": "boolean" },
        "business_name": { "type": "string" },
        "business_address": { "type": "string" },
        "business_phone": { "type": "string" },
        "business_email": { "type": "string" },
        "gst_number": { "type": "string" },
        "logo_url": { "type": "string" },
        "currency": { "type": "string" },
        "bank_name": { "type": "string" },
        "account_name": { "type": "string" },
        "account_number": { "type": "string" },
        "ifsc_code": { "type": "string" },
        "upi_id": { "type": "string" },
        "owner_name": { "type": "string" },
        "social_qr_url": { "type": "string" },
        "backup_enabled": { "type": "boolean" },
        "last_backup_at": { "type": "string", "format": "date-time" },
        "reminders_enabled": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Item": {
      "title": "Item",
      "description": "Product or service item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "stock": { "type": "integer" },
        "low_stock_threshold": { "type": "integer" },
        "barcode": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "gst_number": { "type": "string" },
        "company_name": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "name"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "invoice_number": { "type": "string" },
        "bill_type": { "type": "string" },
        "date": { "type": "string" },
        "due_date": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "currency": { "type": "string" },
        "upi_url": { "type": "string" },
        "last_reminded_at": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "invoice_number", "date", "items", "total"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "invoice_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "method": { "type": "string" },
        "reference": { "type": "string" },
        "note": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "amount", "date"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "reference": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "amount", "date"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Purchase record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "supplier_name": { "type": "string" },
        "description": { "type": "string" },
        "payment_method": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "amount", "date"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "text": { "type": "string" },
        "read": { "type": "boolean" },
        "category": { "type": "string" },
        "target_id": { "type": "string" },
        "target_collection": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "text", "read"]
    },
    "RecycleBinItem": {
      "title": "RecycleBinItem",
      "description": "Soft deleted item stored in recycle bin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "original_collection": { "type": "string" },
        "original_id": { "type": "string" },
        "title": { "type": "string" },
        "deleted_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "original_collection", "deleted_at"]
    },
    "SubscriptionRequest": {
      "title": "SubscriptionRequest",
      "description": "UPI subscription verification requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_email": { "type": "string" },
        "user_name": { "type": "string" },
        "amount": { "type": "number" },
        "billing_cycle": { "type": "string" },
        "payment_method": { "type": "string" },
        "upi_id_ref": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "user_email", "upi_id_ref", "status"]
    },
    "SubscriptionReceipt": {
      "title": "SubscriptionReceipt",
      "description": "Generated PDF receipts for subscription approvals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receipt_number": { "type": "string" },
        "user_id": { "type": "string" },
        "user_email": { "type": "string" },
        "user_name": { "type": "string" },
        "amount": { "type": "number" },
        "billing_cycle": { "type": "string" },
        "payment_method": { "type": "string" },
        "upi_id_ref": { "type": "string" },
        "pdf_base64": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["receipt_number", "user_id", "user_email", "amount", "created_at"]
    },
    "Template": {
      "title": "Template",
      "description": "User custom invoice template configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "base_template": { "type": "string" },
        "primary_color": { "type": "string" },
        "logo_position": { "type": "string" },
        "font_family": { "type": "string" },
        "footer_text": { "type": "string" },
        "column_labels": { "type": "object" },
        "column_visibility": { "type": "object" },
        "hide_sections": { "type": "object" },
        "is_default": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "name", "base_template"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "templates/{templateId}": {
      "schema": "Template",
      "description": "User custom template configurations"
    },
    "items/{itemId}": {
      "schema": "Item",
      "description": "Product items"
    },
    "customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer records"
    },
    "invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices"
    },
    "payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payments"
    },
    "expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expenses"
    },
    "purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Purchases"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "recycle_bin/{binDocId}": {
      "schema": "RecycleBinItem",
      "description": "Recycle bin items"
    },
    "subscription_requests/{requestId}": {
      "schema": "SubscriptionRequest",
      "description": "Subscription verification requests"
    },
    "subscription_receipts/{receiptId}": {
      "schema": "SubscriptionReceipt",
      "description": "Subscription receipts"
    }
  }
}
