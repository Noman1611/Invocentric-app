{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://www.gstatic.com https://identitytoolkit.googleapis.com https://www.googletagmanager.com https://tagassistant.google.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: *; connect-src 'self' *; font-src 'self' https://fonts.gstatic.com data:; frame-src 'self' https://*.firebaseapp.com https://www.googletagmanager.com https://tagassistant.google.com; frame-ancestors 'self' https://tagassistant.google.com; object-src 'none';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!sw\\.js|registerSW\\.js|manifest\\.webmanifest).*)",
      "has": [
        {
          "type": "host",
          "value": "bill-craft-weld.vercel.app"
        }
      ],
      "destination": "https://invocentric.in/$1",
      "permanent": true
    },
    {
      "source": "/((?!sw\\.js|registerSW\\.js|manifest\\.webmanifest).*)",
      "has": [
        {
          "type": "host",
          "value": "bill-craft.vercel.app"
        }
      ],
      "destination": "https://invocentric.in/$1",
      "permanent": true
    },
    {
      "source": "/((?!sw\\.js|registerSW\\.js|manifest\\.webmanifest).*)",
      "has": [
        {
          "type": "host",
          "value": "invocentric.vercel.app"
        }
      ],
      "destination": "https://invocentric.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 */4 * * *"
    }
  ]
}