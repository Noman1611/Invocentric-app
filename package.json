{
  "name": "invocentric",
  "private": true,
    "version": "1.0.21",
  "description": "InvoCentric - Professional GST Billing, Inventory & Accounting Software",
  "author": "InvoCentric <support@invocentric.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:electron": "esbuild electron/main.src.cjs --bundle --platform=node --external:electron --outfile=electron/main.cjs",
    "electron": "npm run build:electron && electron .",
    "electron:build": "vite build && npm run build:electron && electron-builder --win",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "lint": "eslint . && tsc --noEmit",
    "test": "node tests/run-all-tests.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.3.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.13.0",
    "helmet": "^8.2.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "number-to-words": "^1.2.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-error-boundary": "^6.1.1",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.invocentric.app",
    "productName": "InvoCentric",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/512x512.png"
    },
    "nsis": {
      "artifactName": "InvoCentric-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InvoCentric"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Noman1611",
        "repo": "Invocentric-app",
        "releaseType": "release"
      }
    ]
  }
}
